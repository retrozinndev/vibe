{
    "$schema": "https://json.schemastore.org/tsconfig.json",
    "compilerOptions": {
        "rootDir": ".",
        "allowJs": false,
        "lib": ["ES2025"],
        "moduleResolution": "bundler",
        "skipLibCheck": true,
        "strict": true,
        "jsx": "react-jsx",
        "jsxImportSource": "gnim/gtk4",
        "noImplicitThis": true,
        "useUnknownInCatchVariables": true,
        "forceConsistentCasingInFileNames": true,
        "types": ["gi"],
        "typeRoots": [".types"]
    },
    "exclude": [".types"]
}
